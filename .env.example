# PostgreSQL connection string (Supabase / Railway / local)
DATABASE_URL="postgresql://user:password@localhost:5432/travel_agency_saas"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Only needed if you add OAuth providers later
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------
# Phase 7 — real GDS/API integration (optional)
# Leave all of this unset to keep using the built-in mock flight/hotel
# providers — the app works fully out of the box either way.
# ---------------------------------------------------------------

# Flights: set to "amadeus" or "duffel" to go live. Anything else (or unset)
# uses the mock provider. Falls back to mock automatically if the live call
# errors, so it's safe to leave misconfigured during development.
# FLIGHT_PROVIDER=amadeus

# Amadeus for Developers (https://developers.amadeus.com) — free test keys.
# Used for both flights (FLIGHT_PROVIDER=amadeus) and hotels (HOTEL_PROVIDER=amadeus).
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test   # "test" (default) or "production"

# Duffel (https://duffel.com) — alternative flight provider.
# DUFFEL_API_KEY=

# Hotels: set to "amadeus" to go live, otherwise uses the mock provider.
# HOTEL_PROVIDER=amadeus
